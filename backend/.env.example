# Salin ke .env (backend/.env) lalu sesuaikan. JANGAN commit .env asli.
PORT=8080
APP_ENV=development

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kawangizi
DB_PASSWORD=ganti-dengan-password-database
DB_NAME=kawangizi
DB_SSLMODE=disable

# Auth
JWT_SECRET=kawangizi-dev-secret-ganti-di-produksi
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# CORS: daftar origin klien yang diizinkan, dipisah koma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LAYANAN AI (WAJIB diisi di produksi; tanpa ini setiap POST /api/scans balas 502)
# Alamat dasar FastAPI YOLO, tanpa trailing slash dan tanpa /predict.
# Lokal  : uvicorn app.main:app --host 127.0.0.1 --port 8083
# Hosted : https://<nama-service-ai>.onrender.com
AI_BACKEND_URL=http://127.0.0.1:8083

# Batas waktu (detik). Write timeout selalu otomatis dinaikkan minimal 30 detik
# di atas AI_REQUEST_TIMEOUT_SECONDS kalau nilainya kelewat kecil.
AI_REQUEST_TIMEOUT_SECONDS=60
AI_HEALTH_CHECK_TIMEOUT_SECONDS=3
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=90

# Klien web untuk ditampilkan di landing page
WEB_CLIENT_URL=http://localhost:5173

# Dataset gizi untuk lookup makro saat scan
NUTRITION_DATA_PATH=data/dataset_nutrisi_kasar.csv