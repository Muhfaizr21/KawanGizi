# Salin ke frontend/.env.local lalu sesuaikan. JANGAN commit .env.local asli.

# URL API backend Golang (login, presensi, scan, forum).
# WAJIB diisi saat build produksi: kalau kosong, client menebak <host>:8080 yang
# tidak ada di domain statis, sehingga semua permintaan gagal tanpa petunjuk.
# Lokal  : http://localhost:8080
# Hosted : https://kawangizi-core-api.onrender.com
VITE_API_BASE_URL=https://kawangizi-core-api.onrender.com

# URL API AI Python (deteksi YOLOv8).
VITE_AI_API_URL=https://kawangizi.onrender.com