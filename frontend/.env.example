# Salin ke frontend/.env atau frontend/.env.local atau set di build environment Docker / CI VPS.
# JANGAN commit file .env atau .env.local yang berisi kredensial ke Git.

# URL API backend Golang (Auth, Presensi, Database, Forum).
# Mendukung VITE_API_URL atau VITE_API_BASE_URL:
# - VPS Production   : https://kawangizi-core-api.onrender.com ATAU http://<ip-vps>:8080
# - VPS Reverse Proxy: relative (kosongkan atau isi / bila reverse proxy Nginx mengarahkan /api ke backend)
# - Local Dev        : http://localhost:8080
VITE_API_URL=https://kawangizi-core-api.onrender.com
VITE_API_BASE_URL=https://kawangizi-core-api.onrender.com

# URL API AI Python FastAPI (Deteksi YOLOv8).
# Mendukung VITE_AI_API_URL:
# - VPS / Cloud      : https://kawangizi-6vju.onrender.com ATAU http://<ip-vps>:8083
# - Local Dev        : http://localhost:8083
VITE_AI_API_URL=https://kawangizi-6vju.onrender.com